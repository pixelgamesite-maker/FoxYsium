# ── Supabase (Project settings → API) ─────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Wallets ───────────────────────────────────────────────────────
# Optional. Enables WalletConnect (mobile wallets via QR / deep link).
# Get one at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# ── Network: Kinetiq Elysium ─────────────────────────────────────
# Testnet defaults below. Elysium mainnet goes live Nov 9 2026 — swap
# these for the official mainnet values once Kinetiq publishes them.
VITE_CHAIN_ID=99801
VITE_CHAIN_NAME=Elysium Testnet
VITE_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
VITE_EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer

# ── Contracts (leave blank until deployed; the UI shows "not live yet") ──
VITE_GENESIS_ADDRESS=
VITE_FOX_TOKEN_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_LOCKER_ADDRESS=
# ERC-6551 canonical registry (v0.3). Override only if Elysium uses another.
VITE_VAULT_REGISTRY_ADDRESS=0x000000006551c19487814612e58FE06813775758
VITE_VAULT_IMPLEMENTATION_ADDRESS=

# ── Links ─────────────────────────────────────────────────────────
VITE_SWAP_URL=
VITE_X_URL=https://x.com/
VITE_TELEGRAM_URL=
