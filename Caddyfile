{
	admin off
}

:{$PORT:8080} {
	root * /app/dist
	encode gzip zstd

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# HTML (every app route serves index.html) must revalidate, or browsers keep
	# an old page that points at build files which no longer exist.
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Missing build files must 404 (not fall back to index.html), so an old tab
	# after a redeploy gets a clean error and the app can reload itself.
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
